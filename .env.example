# Shelf — copy to .env.local for local dev
# DB — Neon Postgres (required)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
POSTGRES_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
AUTH_SECRET=change-me-to-32+chars-random
# S3-compatible storage — Neon Storage / Vercel Blob via S3 (required, all docs go to blob)
AWS_ENDPOINT_URL_S3=https://YOUR_NEON_STORAGE_ENDPOINT
AWS_ACCESS_KEY_ID=nak_live_xxx
AWS_SECRET_ACCESS_KEY=nsk_live_xxx
AWS_REGION=us-east-2
# MCP
SHELF_API_URL=http://localhost:3000
